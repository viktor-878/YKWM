#!/usr/bin/python3
import subprocess
import os

# Merge XRDB file
ykwm_data_dir = os.environ.get(
    "FVWM_DATADIR",
    "/usr/local/share/ykwm"
)

xrdb_file_default = os.path.join(
    ykwm_data_dir,
    "default-config",
    "colors"
)
xrdb_file = os.path.expanduser("~/.yekara/colors")

subprocess.run(["xrdb", "-remove", "all"], check=True)
subprocess.run(["xrdb", "-merge", xrdb_file_default], check=True)
subprocess.run(["xrdb", "-merge", xrdb_file], check=False) # user-side file is optional

# Query all resources
xrdb_output = subprocess.check_output(["xrdb", "-query"], text=True)

# Parse XRDB output into a dictionary
xrdb_colors = {}

for line in xrdb_output.splitlines():
    line = line.strip()

    if not line or line.startswith("!"):
        continue

    parts = line.split(None, 1)

    if len(parts) == 2:
        key, value = parts
        key = key.rstrip(":")
        xrdb_colors[key] = value.strip()

# ----------------------------------------------------------
# Map XRDB colors to YKWM Colorsets
# ----------------------------------------------------------

fvwm_colors = {
    0: {
        "fg": xrdb_colors.get("*foreground"),
        "bg": xrdb_colors.get("*background")
    },
    1: {
        "fg": xrdb_colors.get("Ykwm*InactWinColorsetFG"),
        "bg": xrdb_colors.get("Ykwm*InactWinColorsetBG")
    },
    2: {
        "fg": xrdb_colors.get("Ykwm*ActiveWinColorsetFG"),
        "bg": xrdb_colors.get("Ykwm*ActiveWinColorsetBG")
    },
    3: {
        "fg": xrdb_colors.get("Ykwm*InactWinBorderColorsetFG"),
        "bg": xrdb_colors.get("Ykwm*InactWinBorderColorsetBG")
    },
    4: {
        "fg": xrdb_colors.get("Ykwm*ActiveWinBorderColorsetFG"),
        "bg": xrdb_colors.get("Ykwm*ActiveWinBorderColorsetBG")
    },
    5: {
        "fg": xrdb_colors.get("Ykwm*MenuInactItemColorsetFG"),
        "bg": xrdb_colors.get("Ykwm*MenuInactItemColorsetBG")
    },
    6: {
        "fg": xrdb_colors.get("Ykwm*MenuActItemColorsetFG"),
        "bg": xrdb_colors.get("Ykwm*MenuActItemColorsetBG")
    },
    7: {
        "fg": xrdb_colors.get("Ykwm*MenuGrayedItemColorsetFG"),
        "bg": xrdb_colors.get("Ykwm*MenuGrayedItemColorsetBG")
    },
    8: {
        "fg": xrdb_colors.get("Ykwm*MenuTitleColorsetFG"),
        "bg": xrdb_colors.get("Ykwm*MenuTitleColorsetBG")
    },
}

# ----------------------------------------------------------
# Render Table Support -- Changing to YKFont Especification (based on XLFD)
# ----------------------------------------------------------

font_preference = xrdb_colors.get("Yekara*Font", "helvetica, 12")

if "," in font_preference:
    # Split strictly by the comma delimiter, then strip edge whitespaces safely
    font_name, font_size_str = font_preference.split(",", 1)
    font_name = font_name.strip()
    font_size = int(font_size_str.strip())
else:
    # Fallback default if someone misses a comma completely
    font_name = font_preference.strip()
    font_size = 12
default_font = (
    f'DefaultFont '
    f'"xft:{font_name}:size={font_size}:antialias=false*"'
)

toolbox_font = (
    f'*ToolBox: Font '
    f'"xft:{font_name}:size={font_size}:antialias=false"'
)

title_font = (
    f'Style * Font '
    f'"xft:{font_name}:Bold:Oblique:size={font_size + ((font_size / 2)/2)}:antialias=false"' # its twelve by default, this double divide makes it do a 12 + ((12 / 2) / 2), which is essentially a 12 + 2, but, it makes for better rendering of bigger fonts
)	

# ----------------------------------------------------------
# Color Helpers
# ----------------------------------------------------------

def hex_to_rgb(hexcolor):
    hexcolor = hexcolor.lstrip("#")
    return tuple(
        int(hexcolor[i:i + 2], 16)
        for i in (0, 2, 4)
    )

def rgb_to_hex(rgb):
    return "#{:02X}{:02X}{:02X}".format(*rgb)

def scale_color(rgb, factor):
    return tuple(
        max(0, min(255, int(channel * factor)))
        for channel in rgb
    )

def compute_bevels(
    bg_hex,
    highlight_strength=0.93,
    shadow_strength=0.5
):
    if not bg_hex or not bg_hex.startswith("#"):
        return None, None

    r, g, b = hex_to_rgb(bg_hex)

    # Highlight toward white
    hr = int(r + (255 - r) * highlight_strength)
    hg = int(g + (255 - g) * highlight_strength)
    hb = int(b + (255 - b) * highlight_strength)

    # Shadow toward black
    sr = int(r * (1 - shadow_strength))
    sg = int(g * (1 - shadow_strength))
    sb = int(b * (1 - shadow_strength))

    return (
        rgb_to_hex((hr, hg, hb)),
        rgb_to_hex((sr, sg, sb))
    )

# ----------------------------------------------------------
# Pretty-print function for debugging
# ----------------------------------------------------------

def pretty_print_colors(colors):
    for number, col in colors.items():
        fg = col["fg"] if col["fg"] is not None else "MISSING"
        bg = col["bg"] if col["bg"] is not None else "MISSING"

        highlight = shadow = "MISSING"

        if col["bg"] and col["bg"].startswith("#"):
            highlight, shadow = compute_bevels(col["bg"])

        print(
            f"Colorset {number} "
            f"fg {fg}, "
            f"bg {bg}, "
            f"hi {highlight}, "
            f"sh {shadow}"
        )

    print()
    print(default_font)
    print(toolbox_font)
    print(title_font)

pretty_print_colors(fvwm_colors)
