# SetEnv YK_APPS_PATH /applications:~/applications # thanks to Punk-Walker, this might not be needed anymore
IgnoreModifiers L25

PipeRead "ykwm-read-xresource-colors"
PipeRead "ykwm-applications-menu"
Exec "YKBackdrop"
Exec xrandr --dpi 72
Read $./components/core.fvwm
Read $./components/toolbox.fvwm
Read $./components/coreBindings.fvwm
Read $./components/ROOTMENU.fvwm
Read $./components/transientConfig.fvwm

AddToFunc StartFunction
+ I Exec mpv --no-video $./startup.wav

Style * BackingStore
SetEnv XDG_CURRENT_DESKTOP YK:YeKara
SetEnv DESKTOP_SESSION YK:YeKara
SetEnv XDG_SESSION_DESKTOP YK:YeKara
Style sessionWindow Layer 6, Sticky
Style SessionWindow Layer 6, Sticky
Exec yk-runner "File Cabinet" --desktop
Style YeKaraDesktop !Title, !Handles, !Borders, BorderWidth 0, !Button 1, !Button 2, !Button 4, !Closable, Sticky, StickyStippledTitle, WindowListSkip, !Closable, FixedSize, FixedPosition, !Maximizable, !iconifiable, ResizeOpaque, Layer 0

